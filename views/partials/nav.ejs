<header class="topbar">
  <div class="brand-group">
    <div class="brand-title">
      <a href="/dashboard">Insighta</a>
    </div>
    <div class="brand-subtitle">Profile intelligence for your team</div>
  </div>

  <nav class="nav-links">
    <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/profiles" class="<%= activePage === 'profiles' ? 'active' : '' %>">Profiles</a>
    <a href="/search" class="<%= activePage === 'search' ? 'active' : '' %>">Search</a>
