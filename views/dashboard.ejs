<!DOCTYPE html>
<html>
<head>
  <title>Dashboard - Insighta</title>
  <link rel="stylesheet" href="/styles/dashboard.css">
</head>
<body>

<header class="header">
  <div class="left">
    <h2>Insighta Dashboard</h2>
    <div class="sub">Profile Intelligence System</div>
  </div>

  <div class="right">
    <span class="user">
      <%= user?.username || "Guest" %>
      (<%= user?.role || "user" %>)
    </span>

    <% if (user?.role === "admin") { %>
      <a href="/export">Export CSV</a>
    <% } %>

    <a href="/auth/logout" class="logout-btn">Logout</a>
  </div>
</header>

<div class="container">
  <h2>Profile Management</h2>

  <% if (error) { %>
    <div class="error-message"><%= error %></div>
  <% } %>

  <div class="search-section">
    <form action="/profiles/search" method="GET" class="search-form">
      <input type="text" name="q" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Search profiles by name..." required />
      <button type="submit" class="search-btn">Search</button>
      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <a href="/dashboard" class="clear-search">Clear Search</a>
      <% } %>
    </form>
  </div>

  <% if (user?.role === "admin") { %>
    <div class="create-profile">
      <form action="/profiles" method="POST" class="profile-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="text" name="name" placeholder="Enter profile name" required />
        <button type="submit" class="create-btn">Create Profile</button>
      </form>
    </div>
  <% } %>

  <% if (!profiles || profiles.length === 0) { %>
    <div class="no-profiles">
      <p>No profiles found. <%= user?.role === "admin" ? "Create your first profile above." : "Contact an administrator to create profiles." %></p>
    </div>
  <% } else { %>
    <div class="sheet">
      <div class="row table-header">
        <div>Name</div>
        <div>Age</div>
        <div>Gender</div>
        <div>Country</div>
        <% if (user?.role === "admin") { %>
          <div>Actions</div>
        <% } %>
      </div>

      <% profiles.forEach(profile => { %>
        <div class="row">
          <div><%= profile.name || 'N/A' %></div>
          <div><%= profile.age || 'N/A' %></div>
          <div><%= profile.gender || 'N/A' %></div>
          <div><%= profile.country_id || 'N/A' %></div>
          <% if (user?.role === "admin") { %>
            <div class="actions">
              <form action="/profiles/<%= profile.id %>?_method=DELETE" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this profile?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="delete-btn">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="pagination">
    <% if (page > 1) { %>
      <a href="/dashboard?page=<%= page - 1 %>" class="page-btn">Previous</a>
    <% } %>

    <span class="page-info">Page <%= page %></span>

    <% if (profiles && profiles.length > 0) { %>
      <a href="/dashboard?page=<%= page + 1 %>" class="page-btn">Next</a>
    <% } %>
  </div>
</div>

</body>
</html>
