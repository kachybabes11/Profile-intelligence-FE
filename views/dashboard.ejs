<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard - Insighta</title>
  <link rel="stylesheet" href="/styles/app.css" />
</head>
<body>
  <%- include('partials/nav', { user, activePage: 'dashboard' }) %>

  <main class="page-container">
    <section class="page-header">
      <div>
        <h1>Dashboard</h1>
        <p>A simple overview of your profile intelligence workspace.</p>
      </div>
      <div class="page-actions">
        <a href="/profiles" class="button secondary">View Profiles</a>
        <a href="/search" class="button secondary">Search</a>
      </div>
    </section>

    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <section class="metrics-grid">
      <div class="metric-card">
        <span>Total profiles</span>
        <strong><%= metrics.totalProfiles %></strong>
      </div>
      <div class="metric-card">
        <span>Your role</span>
        <strong><%= user.role %></strong>
      </div>
      <div class="metric-card">
        <span>Current page</span>
        <strong><%= metrics.currentPage %></strong>
      </div>
    </section>

    <section class="panel">
      <div class="panel-header">
        <h2>Recent profiles</h2>
        <span>Page <%= page %></span>
      </div>

      <% if (!profiles || profiles.length === 0) { %>
        <div class="empty-state">
          <p>No profiles are available yet. Use the profiles page to add and manage records.</p>
        </div>
      <% } else { %>
        <div class="table-card">
          <div class="table-row table-head">
            <div>Name</div>
            <div>Age</div>
            <div>Gender</div>
            <div>Country</div>
            <div>Detail</div>
          </div>
          <% profiles.slice(0, 6).forEach(profile => { %>
            <div class="table-row">
              <div><%= profile.name || 'N/A' %></div>
              <div><%= profile.age || 'N/A' %></div>
              <div><%= profile.gender || 'N/A' %></div>
              <div><%= profile.country_name || profile.country_id || 'N/A' %></div>
              <div><a class="small-link" href="/profiles/<%= profile.id %>">View</a></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
